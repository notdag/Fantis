# ---------------------------------------------------------------------------
# This is a TEMPLATE. Copy it to a file named ".env" and fill in real values.
# Never share or commit your real ".env" — it holds secrets.
# You don't need most of these until later steps. Sleeper needs none of them.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) — now required for /manager (Sleeper Manager) ---
# The rest of Fantis still works without this. Get a free Postgres DB via
# Vercel's Storage tab (Postgres/Neon integration) or neon.tech directly,
# then run `npx prisma migrate dev` once this is set.
DATABASE_URL="postgresql://user:password@localhost:5432/fantis?schema=public"

# --- Auth (NextAuth) — needed at step 3 ------------------------------------
# Generate a secret by running:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (payments) — needed at step 5 ----------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID_PREMIUM=""

# --- Yahoo Fantasy OAuth — needed at step 4 --------------------------------
YAHOO_CLIENT_ID=""
YAHOO_CLIENT_SECRET=""

# --- Sleeper ---------------------------------------------------------------
# No keys required — Sleeper's read API is public.

# --- SharpAPI (sharpapi.io) — MVP/award futures for the Rankings panel ------
# Free tier, no card required: https://sharpapi.io/pricing
# Server-side only (app/api/mvp-odds/route.ts) — never prefix with
# NEXT_PUBLIC_ or it will leak into the client bundle.
SHARPAPI_API_KEY=""

# --- SportsGameOdds (sportsgameodds.com) — player props for the Rankings ---
# --- panel and the Trade calculator's weekly market delta ------------------
# Free "Amateur" tier, no card required: https://sportsgameodds.com/pricing
# Server-side only (app/api/player-props/route.ts) — never prefix with
# NEXT_PUBLIC_ or it will leak into the client bundle.
SPORTSGAMEODDS_API_KEY=""

# --- Admin tier board (/admin) — owner-only, not a real accounts system ----
# A shared passphrase, not a password — checked server-side, stored as a
# hash in an httpOnly cookie (lib/adminAuth.ts). Pick your own value; don't
# reuse a real password anywhere.
ADMIN_PASSPHRASE=""
